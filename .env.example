# --- Banco de dados (backend) ---
# PostgreSQL. Em Docker: postgresql://user:pass@db:5432/prospector
DATABASE_URL=postgresql://user:password@localhost:5432/prospector

# --- Auth (NextAuth) ---
# Obrigatório. Mesmo domínio do front (ex.: precisionia.com.br)
NEXTAUTH_URL=https://precisionia.com.br
# Alias usado pelo backend
AUTH_URL=https://precisionia.com.br
AUTH_SECRET=your_auth_secret_here
# Opcional: confiança no host (ex.: true em produção atrás de proxy)
# AUTH_TRUST_HOST=true
# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- App e frontend ---
# URL pública do app (callbacks Mercado Pago/Stripe, OAuth, emails)
NEXT_PUBLIC_APP_URL=https://precisionia.com.br
# CORS: origem permitida para o frontend (opcional)
# FRONTEND_URL=https://precisionia.com.br

# --- Billing: Stripe ---
# Chave secreta e webhook (obrigatório se usar Stripe)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Billing: Mercado Pago ---
# Access token (obrigatório se usar Mercado Pago)
# MERCADOPAGO_ACCESS_TOKEN=APP_USR_...

# --- Cron / jobs ---
# Segredo para POST /api/billing/apply-pending-plans (header: x-cron-secret)
# Garantir que o cron em produção use este valor. Ver RUNBOOK.
BILLING_CRON_SECRET=your_cron_secret_here
# Segredo para GET /api/cron/affiliate-approve-commissions (e grace-period).
# No backend: defina este valor. No GitHub Actions (cron de afiliados): crie o secret
# CRON_SECRET com o MESMO valor e BACKEND_URL com a URL base do app (ex.: https://precisionia.com.br).
CRON_SECRET=your_cron_secret_here

# --- APIs externas ---
# Google Places API (New). Ativar em: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=your_google_api_key_here
# Gemini. Chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenRouter (free tier) ---
# Chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Fallback provider: GEMINI | CLOUDFLARE | OPENROUTER
# AI_FALLBACK_PROVIDER=OPENROUTER
# AI_ALWAYS_INCLUDE_ENV_FALLBACK=true
# Modelos free (comma-separated, suffix :free):
# AI_OPENROUTER_MODELS_LEAD_ANALYSIS=liquid/lfm-2.5-1.2b-instruct:free,meta-llama/llama-3.3-70b-instruct:free
# AI_OPENROUTER_MODELS_VIABILITY=liquid/lfm-2.5-1.2b-instruct:free,meta-llama/llama-3.2-3b-instruct:free
# AI_OPENROUTER_MODELS_COMPANY_ANALYSIS=liquid/lfm-2.5-1.2b-instruct:free,google/gemma-4-26b-a4b-it:free

# --- Redis (opcional) ---
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# --- Email (Resend) ---
# RESEND_API_KEY=re_...
# EMAIL_FROM=Prospector <noreply@seudominio.com>

# --- Admin e suporte ---
# Emails com acesso total ao /admin (separados por vírgula)
# ADMIN_EMAILS=admin1@example.com,admin2@example.com
# Emails com acesso apenas à área de suporte
# SUPPORT_EMAILS=support1@example.com,support2@example.com

# --- Frontend (Vite): contato na página Suporte ---
# VITE_SUPPORT_EMAIL=support@precisionia.com.br
# VITE_SUPPORT_WHATSAPP=5511912801461
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXXX
# VITE_GOOGLE_ADS_CONVERSION_LABEL=ti5lCKSf7p0cELXggbZD

# --- Outros (opcional) ---
# LOG_LEVEL=info|error
# SITE_URL — fallback para NEXT_PUBLIC_APP_URL em emails/links
# EMAIL_LOGO_URL — URL do logo em emails
# AI_CONFIG_ENCRYPTION_KEY — criptografia de config de IA (fallback: AUTH_SECRET)
# TWOFA_ISSUER — nome do emissor 2FA (default: Prospector)
# VITE_API_TARGET — alvo do proxy /api no admin (Docker: http://backend:4000)

# --- Observabilidade: Telegram Alerts ---
# Bot criado via @BotFather. Alertas de erros, billing, health checks.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234...
# TELEGRAM_CHAT_ID=-100123456789

# --- Billing: MercadoPago Webhook Secret ---
# HMAC secret para validar webhooks (obrigatório em produção!)
# MERCADOPAGO_WEBHOOK_SECRET=your_mp_webhook_secret

# --- Push Notifications (VAPID) ---
# Gerar com: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- CRM: RD Station ---
# RD_STATION_CLIENT_ID=
# RD_STATION_CLIENT_SECRET=
# RD_STATION_PRODUCT=crm

# --- CRM: HubSpot ---
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=

# --- CRM: Agendor ---
# AGENDOR_API_TOKEN=
