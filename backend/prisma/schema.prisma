// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  TRIAL
  BASIC
  PRO
  BUSINESS
  SCALE
}

enum AnalysisStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

enum AiConfigRole {
  LEAD_ANALYSIS
  VIABILITY
  COMPANY_ANALYSIS
}

enum AiConfigProvider {
  GEMINI
  OPENAI
  CLOUDFLARE
  GROQ
  DEEPSEEK
  ANTHROPIC
  OPENROUTER
}

enum NotificationType {
  INFO
  ALERT
  REMINDER
  SYSTEM
}

enum LeadContactType {
  PHONE
  EMAIL
  WEBSITE
}

enum LeadContactSource {
  GOOGLE
  RECEITA
  WEBSITE_SCRAPER
  WEB_SEARCH
  MANUAL
}

enum LeadContactRoleHint {
  OWNER
  COMMERCIAL
  CENTRAL
  ACCOUNTANT
  UNKNOWN
}

model User {
  id            String    @id @default(cuid())
  market        String    @default("BR")
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  resetToken          String?   @unique
  resetTokenHash      String?
  resetTokenExpires   DateTime?

  twoFactorSecret   String?
  twoFactorEnabled  Boolean    @default(false)


  // Third-party integrations (tokens stored encrypted)
  rdStationToken          String?   @db.Text
  rdStationRefreshToken   String?   @db.Text
  rdStationTokenExpiresAt DateTime?
  agendorApiTokenEncrypted String?  @db.Text
  hubspotToken            String?   @db.Text
  hubspotRefreshToken     String?   @db.Text
  hubspotTokenExpiresAt   DateTime?

  subscriptionId String?   @unique
  customerId     String?
  subscriptionStatus String?
  currentPeriodEnd   DateTime?
  
  // Business Profile (preenchido no onboarding; usado para buscas/IA)
  companyName    String?
  productService String?
  targetAudience String?
  mainBenefit    String?

  // Personal profile (per user)
  phone         String?
  address       String?
  linkedInUrl   String?
  instagramUrl  String?
  facebookUrl   String?
  websiteUrl    String?

  // Onboarding: só acessa dashboard após concluir
  onboardingCompletedAt DateTime?

  // Suporte/admin podem desativar conta; login bloqueado quando preenchido
  disabledAt     DateTime?

  // Notification preferences (used when sending alert emails)
  notifyByEmail      Boolean @default(true)
  notifyWeeklyReport Boolean @default(false)
  notifyLeadAlerts   Boolean @default(false)

  // Legacy / Default Credits (moving to Workspace)
  plan           Plan      @default(FREE)
  leadsUsed      Int       @default(0)
  leadsLimit     Int       @default(10)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth Relations
  accounts      Account[]
  sessions      Session[]
  
  // App Relations
  workspaces           WorkspaceMember[]
  workspaceInvitations WorkspaceInvitation[] @relation("Inviter")
  analyses             LeadAnalysis[]
  searchHistory        SearchHistory[]
  tags                 LeadTag[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  affiliate            Affiliate?
  referrals            Referral[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id         String   @id @default(cuid())
  market     String   @default("BR")
  name       String?
  plan               Plan     @default(FREE)
  leadsUsed          Int      @default(0)
  leadsLimit         Int      @default(10)
  subscriptionStatus String?
  subscriptionId     String?
  customerId         String?
  currentPeriodEnd   DateTime?
  /** Billing cycle for current subscription: monthly or annual. Used for proration on upgrade. */
  billingCycle       String?   // 'monthly' | 'annual'
  gracePeriodEnd     DateTime?
  /** Downgrade scheduled for end of period: plan to apply at pendingPlanEffectiveAt */
  pendingPlanId      String?   // PlanType key, e.g. BUSINESS
  pendingPlanEffectiveAt DateTime?
  /** BR Starter promo (R$59 x 6 months) — set when trial expires or via email link */
  starterPromoEligible   Boolean  @default(false)
  starterPromoCode       String?
  promoPaymentsRemaining Int?
  promoRegularAmountBrl  Int?
  /** When BR trial reactivation promo email was sent (dedup for cron/script). */
  reactivationPromoSentAt DateTime?
  tokenVersion  Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Business profile (one per workspace; shared by all members)
  companyName    String?
  legalName      String?
  tradeName      String?
  cnpj           String?
  primaryCnaeCode String?
  primaryCnaeDescription String?
  companySize    String?
  foundingDate   String?
  productService String?
  targetAudience String?
  mainBenefit    String?
  address        String?
  postalCode     String?
  street         String?
  number         String?
  complement     String?
  neighborhood   String?
  city           String?
  state          String?
  linkedInUrl    String?
  instagramUrl   String?
  facebookUrl    String?
  websiteUrl     String?
  logoUrl        String?
  serviceModel   String?
  averageTicket  Float?
  operationRadiusKm Int?
  knownCompetitors String?

  /// Controla acesso ao módulo de Auto-Prospecção (ativado pelo admin do sistema)
  autoProspeccaoEnabled Boolean @default(false)

  members              WorkspaceMember[]
  invitations          WorkspaceInvitation[]
  analyses             LeadAnalysis[]
  searchHistory        SearchHistory[]
  usageEvents          UsageEvent[]
  intelligenceReports  IntelligenceReport[]
  autoProspeccaoConfig AutoProspeccaoConfig?
  autoProspeccaoRuns   AutoProspeccaoRun[]
  autoProspSenderPool  AutoProspSenderPool[]
  prospectedLeads      ProspectedLead[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("OWNER")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Sales goals (set by admin/owner)
  dailyLeadsGoal         Int?  // target leads contacted per day
  dailyAnalysesGoal      Int?  // target AI analyses per day
  monthlyConversionsGoal Int?  // target conversions per month

  // Credit limits per member (null = no individual cap, uses workspace pool)
  dailyLeadsLimit   Int?  // max consumptions (search + analysis) per calendar day
  weeklyLeadsLimit  Int?  // max consumptions in rolling 7 days
  monthlyLeadsLimit Int?  // max consumptions per calendar month

  /// Acesso ao módulo de Auto-Prospecção (ativado pelo owner da workspace)
  autoProspeccaoEnabled Boolean @default(false)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

/// Convite pendente para workspace. Usuário só vira membro ao aceitar (link no email).
model WorkspaceInvitation {
  id           String   @id @default(cuid())
  email        String
  workspaceId  String
  invitedById  String
  token        String   @unique
  status       String   @default("PENDING") // PENDING | ACCEPTED | EXPIRED
  lastSentAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation("Inviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([email, workspaceId])
  @@index([token])
  @@index([workspaceId])
}

model Lead {
  id               String   @id @default(cuid())
  placeId          String   @unique
  name             String
  address          String?
  phone            String?
  email            String?
  website          String?
  cnpj             String?  @db.VarChar(14)
  companyLegalName String?
  companyTradeName String?
  companySize      String?
  companyPorte     String?
  companyLegalNature String?
  companyMainCnae  String?
  companyCapitalSocial Float?
  cnpjStatus       String?
  cnpjOpenedAt     String?
  cnpjLastFetchedAt DateTime?
  rating           Float?
  reviewCount      Int?
  types            Json?
  businessStatus   String?
  lastSearchedAt   DateTime? @default(now())
  opportunityScore Int?      // 0-100 unified opportunity score
  scoreFactors     Json?     // { noWebsite, fewReviews, lowRating, noPhone, ... }
  lastScoredAt     DateTime?
  matchConfidence  Int?      // 0-100 RF match confidence
  matchMethod      String?   // cnpj_direct, name_exact_city, name_fuzzy_city, etc.
  recommendedPhone String?
  recommendedEmail String?
  recommendedWebsite String?
  contactsHealthScore Int?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  analyses         LeadAnalysis[]
  tags             LeadTag[]
  contacts         LeadContact[]

  @@index([cnpj])
  @@index([lastSearchedAt(sort: Desc)])
}

model LeadContact {
  id              String              @id @default(cuid())
  leadId          String
  type            LeadContactType
  source          LeadContactSource
  roleHint        LeadContactRoleHint @default(UNKNOWN)
  valueRaw        String
  valueNormalized String
  confidenceScore Int?                // 0-100
  isPrimary       Boolean             @default(false)
  evidence        Json?
  firstSeenAt     DateTime            @default(now())
  lastSeenAt      DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, type, valueNormalized, source])
  @@index([leadId])
  @@index([type])
  @@index([valueNormalized])
  @@index([source])
}

model LeadAnalysis {
  id                       String         @id @default(cuid())
  userId                   String
  leadId                   String
  workspaceId              String?
  
  score                    Int?
  scoreLabel               String?
  summary                  String?        @db.Text
  strengths                Json?
  weaknesses               Json?
  painPoints               Json?
  gaps                     Json?
  status                   AnalysisStatus @default(NEW)
  
  approach                 String?        @db.Text
  contactStrategy          String?        @db.Text
  firstContactMessage      String?        @db.Text
  suggestedWhatsAppMessage String?        @db.Text
  fullReport               String?        @db.Text
  
  socialInstagram          String?
  socialFacebook           String?
  socialLinkedin           String?
  isFavorite               Boolean        @default(false)

  // --- Lead Intelligence Engine ---
  closeProbability         Int?           // 0-100% AI-predicted chance of closing
  estimatedDealValue       Float?         // Estimated deal size in BRL
  bestContactWindow        String?        // e.g. "Terça 10h-12h"
  reclameAquiAnalysis      String?        @db.Text  // AI analysis of Reclame Aqui data
  jusBrasilAnalysis        String?        @db.Text  // AI analysis of legal proceedings
  cnpjAnalysis             String?        @db.Text  // AI analysis of CNPJ/RF data
  reviewTrend              String?        // IMPROVING, STABLE, DECLINING
  suggestedContactTime     String?        // e.g. "Segunda a Sexta, 9h-11h"
  conversionReason         String?        @db.Text  // Why converted/lost (user fills)
  dealValue                Float?         // Actual deal value (user fills on CONVERTED)
  lostReason               String?        // PRICE | NO_NEED | COMPETITOR | NO_RESPONSE | OTHER
  contactedAt              DateTime?      // When status changed to CONTACTED
  convertedAt              DateTime?      // When status changed to CONVERTED
  lostAt                   DateTime?      // When status changed to LOST

  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([leadId])
  @@index([workspaceId])
}

// Histórico de buscas para reaproveitamento e auditoria
model SearchHistory {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String
  textQuery    String
  pageSize     Int?
  filters      Json?    // hasWebsite, hasPhone, includedType, etc.
  resultsCount Int?
  resultsData  Json?    // Array of places returned from search, for history detail view
  city         String?
  state        String?
  country      String?
  createdAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@index([createdAt])
}

// Audit log para ações admin (suporte e conformidade)
model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  adminEmail  String?
  action      String
  resource    String?
  resourceId  String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// Configuração de provedores de IA por papel (admin; chaves criptografadas)
model AiProviderConfig {
  id                String          @id @default(cuid())
  role               AiConfigRole
  provider           AiConfigProvider
  model              String
  apiKeyEncrypted    String?         @db.Text
  cloudflareAccountId String?        // necessário para CLOUDFLARE
  enabled            Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([role])
  @@index([enabled])
}

enum UsageEventType {
  GOOGLE_PLACES_SEARCH
  GOOGLE_PLACES_DETAILS
  SERPER_REQUEST
  AI_TOKENS
}

model UsageEvent {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String?
  type        UsageEventType
  quantity    Int            @default(1)  // e.g. number of Serper queries or 1 per request
  metadata    Json?          // for AI_TOKENS: { provider, model, inputTokens, outputTokens }
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([type])
  @@index([createdAt])
}

enum WebSearchProvider {
  SERPER
  TAVILY
}

// Configuração de busca na web por papel (enriquecimento de contexto para IA)
model WebSearchConfig {
  id                String            @id @default(cuid())
  role               AiConfigRole
  provider           WebSearchProvider
  apiKeyEncrypted    String?           @db.Text
  maxResults         Int               @default(5)
  enabled            Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([role])
  @@index([enabled])
}

// Runtime controls for AI/analyze throughput and fallback behavior
model AiRuntimeConfig {
  id                               String   @id @default(cuid())
  key                              String   @unique @default("default")
  analyzeRateLimitMax              Int      @default(15)
  analyzeRateLimitWindowSeconds    Int      @default(60)
  analyzeBulkheadMaxInFlight       Int      @default(12)
  analyzeBulkheadAcquireTimeoutMs  Int      @default(12000)
  aiModelMaxInFlight               Int      @default(4)
  analyzeAiMaxOutputTokens         Int      @default(16384)
  aiCircuitBreakerFailureThreshold Int      @default(3)
  aiCircuitBreakerOpenMs           Int      @default(30000)
  aiFallbackProvider               String   @default("GEMINI")
  aiCloudflareModelsLeadAnalysis   String   @default("")
  aiCloudflareModelsViability      String   @default("")
  aiCloudflareModelsCompanyAnalysis String  @default("")
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt
}

// Tags de leads para pipeline de vendas
model LeadTag {
  id          String   @id @default(cuid())
  userId      String
  leadId      String
  workspaceId String?
  label       String        // "Quente", "Morno", "Frio", "Retornar segunda", etc
  color       String        @default("gray") // gray, red, amber, green, blue, violet
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([userId, leadId, label])
  @@index([userId])
  @@index([leadId])
  @@index([workspaceId])
}

// In-app notifications (bell dropdown; admin can send to all)
model Notification {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String?
  title       String
  message     String           @db.Text
  type        NotificationType @default(INFO)
  link        String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

// Admin: ligar/desligar notificação no app e por email por canal (lead_analysis_ready, team_invite, admin_broadcast)
model NotificationChannelConfig {
  key         String   @id
  name        String
  appEnabled  Boolean  @default(true)
  emailEnabled Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Web Push subscriptions (browser + mobile PWA)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @db.Text
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

// Planos configuráveis via admin
model PlanConfig {
  id               String   @id @default(cuid())
  key              String   @unique           // FREE, BASIC, PRO, BUSINESS, SCALE, etc.
  name             String                     // Display name
  leadsLimit       Int      @default(10)
  priceMonthlyBrl  Float    @default(0)
  priceAnnualBrl   Float    @default(0)
  priceMonthlyUsd  Float    @default(0)
  priceAnnualUsd   Float    @default(0)
  modules          Json     @default("[]")    // ModuleKey[]
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

// Resultados persistidos dos módulos de inteligência (Concorrência, Relatórios, Viabilidade)
model IntelligenceReport {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String
  module       String   // COMPETITORS | MARKET | VIABILITY
  inputQuery   String
  inputCity    String?
  inputState   String?
  resultsData  Json     // Full report JSON
  isFavorite   Boolean  @default(false)
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([module])
  @@index([createdAt])
}

// --- Sistema de afiliados ---
enum AffiliateStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum AffiliateCommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum RefSource {
  QUERYSTRING
  COOKIE
  METADATA
}

model Affiliate {
  id                    String    @id @default(cuid())
  code                  String    @unique
  status                AffiliateStatus @default(PENDING)
  userId                String?   @unique // null = afiliado externo (cadastrado pelo admin)
  name                  String?   // para afiliado externo
  email                 String?
  document              String?   // CPF/CNPJ
  notes                 String?   @db.Text
  commissionRatePercent Int       @default(20)
  payoutType            String?   // PIX | BANK_TRANSFER
  payoutPayload         String?   @db.Text // chave PIX ou dados banco (opcional criptografado)
  approvedAt            DateTime?
  createdByAdminId      String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  referrals    Referral[]
  commissions  AffiliateCommission[]
  clicks       AffiliateClick[]

  @@index([status])
  @@index([userId])
}

model AffiliateClick {
  id         String   @id @default(cuid())
  affiliateId String
  createdAt   DateTime @default(now())
  ipHash      String?  // hash do IP para métricas (opcional)
  userAgent   String?  @db.VarChar(500) // truncado

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([createdAt])
}

model Referral {
  id           String    @id @default(cuid())
  affiliateId  String
  userId       String
  workspaceId  String?
  landedAt     DateTime  @default(now())
  signupAt     DateTime  @default(now())
  convertedAt  DateTime?
  firstPaidAt  DateTime?
  refSource    RefSource @default(QUERYSTRING)
  planId       String?
  valueCents   Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  affiliate   Affiliate   @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  commissions AffiliateCommission[]

  @@index([affiliateId])
  @@index([userId])
  @@index([workspaceId])
  @@index([convertedAt])
}

model AffiliateCommission {
  id             String                    @id @default(cuid())
  affiliateId    String
  referralId     String
  workspaceId    String
  amountCents    Int
  currency       String                    @default("BRL")
  orderId        String?   // Stripe/MP
  subscriptionId String?
  status         AffiliateCommissionStatus @default(PENDING)
  availableAt    DateTime  // vira pagável após hold
  paidAt         DateTime?
  paidByAdminId  String?
  paymentProofUrl String?
  commissionType String    @default("FIRST_PAYMENT") // FIRST_PAYMENT | RECURRING
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referral  Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([status])
  @@index([availableAt])
}

// Config global afiliados (uma linha ou key-value; aqui uma linha com JSON)
model AffiliateSettings {
  id                        String   @id @default(cuid())
  defaultCommissionRatePercent Int    @default(20)
  cookieDurationDays        Int      @default(30)
  commissionRule            String   @default("FIRST_PAYMENT_ONLY") // FIRST_PAYMENT_ONLY | RECURRING
  approvalHoldDays          Int      @default(15)
  minPayoutCents            Int      @default(10000) // R$ 100
  allowSelfSignup           Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
}

// Configuração de e-mail (única por sistema): Resend ou SMTP, editável no admin
model EmailConfig {
  id                     String   @id @default(cuid())
  provider               String   // resend | smtp
  resendApiKeyEncrypted  String?  // cifrado; só quando provider = resend
  fromEmail              String?  // Remetente
  smtpHost               String?
  smtpPort               Int?     // 587, 465
  smtpUser               String?
  smtpPasswordEncrypted  String?  // cifrado; só quando provider = smtp
  updatedAt              DateTime @updatedAt
}

// Configuração de apps OAuth de CRM no painel admin
model CrmIntegrationConfig {
  id                    String   @id @default(cuid())
  provider              String   @unique // rdstation, hubspot, agendor
  clientId              String
  clientSecretEncrypted String
  updatedAt             DateTime @updatedAt
}

// --- Lead Intelligence Engine: Histórico de eventos do lead ---
enum LeadEventType {
  STATUS_CHANGE       // NEW→CONTACTED, CONTACTED→CONVERTED, etc.
  SCORE_CHANGE        // opportunityScore or AI score changed
  AI_ANALYSIS         // New AI analysis generated
  NOTE                // User added a note
  TAG_ADDED           // Tag added
  TAG_REMOVED         // Tag removed
  CRM_SYNCED          // Pushed to RD Station / HubSpot / Agendor
  CONTACTED           // User marked as contacted  
  CONVERTED           // User marked as converted
  LOST                // User marked as lost
}

model LeadEvent {
  id           String        @id @default(cuid())
  leadId       String
  userId       String
  workspaceId  String?
  type         LeadEventType
  
  // Context data (flexible per event type)
  oldValue     String?       // e.g. "NEW" for status change, "45" for score change
  newValue     String?       // e.g. "CONTACTED", "72"
  metadata     Json?         // Extra: { reason, dealValue, note, tagLabel, crmProvider }
  
  createdAt    DateTime      @default(now())

  @@index([leadId])
  @@index([userId])
  @@index([workspaceId])
  @@index([type])
  @@index([createdAt])
}

// --- Pipeline Intelligence: cached daily brief ---
model PipelineBrief {
  id           String   @id @default(cuid())
  userId       String
  workspaceId  String
  briefDate    DateTime @db.Date      // One per day per workspace
  recommendations Json                // Array of { leadId, leadName, reason, priority, suggestedAction }
  stats        Json?                  // { totalActive, avgCloseProbability, hotLeads, conversionRate30d }
  createdAt    DateTime @default(now())

  @@unique([workspaceId, briefDate])
  @@index([userId])
  @@index([workspaceId])
}

// ═══════════════════════════════════════════════════════════════════
// EMAIL MARKETING — Templates, Campanhas, Envios, Unsubscribe
// ═══════════════════════════════════════════════════════════════════

enum EmailTemplateType {
  PROMOTION
  WEEKLY_REPORT
  FEATURE_ANNOUNCEMENT
  REENGAGEMENT
  CUSTOM
}

enum EmailTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum EmailCampaignAudience {
  ALL
  FREE
  PAID
  TRIAL
  CHURNED
  INACTIVE
  CUSTOM
}

enum EmailSendStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

enum EmailSendType {
  TRANSACTIONAL
  CAMPAIGN
  WEEKLY_REPORT
  SYSTEM
}

enum EmailUnsubscribeCategory {
  ALL
  MARKETING
  WEEKLY_REPORT
  PROMOTIONS
}

model EmailTemplate {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  type        EmailTemplateType   @default(CUSTOM)
  status      EmailTemplateStatus @default(DRAFT)
  subject     String
  preheader   String?
  body        Json                // { paragraphs, benefits, badge, badgeColor, subtitle, legalNote, expiresAt, accentColor }
  ctaLabel    String?
  ctaUrl      String?
  accentColor String?
  createdBy   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  campaigns   EmailCampaign[]

  @@index([type])
  @@index([status])
}

model EmailCampaign {
  id              String                @id @default(cuid())
  name            String
  templateId      String
  template        EmailTemplate         @relation(fields: [templateId], references: [id])
  audience        EmailCampaignAudience @default(ALL)
  audienceFilter  Json?                 // { plans, inactiveDays, minDaysSinceSignup, cities }
  status          EmailCampaignStatus   @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  totalRecipients Int                   @default(0)
  totalSent       Int                   @default(0)
  totalFailed     Int                   @default(0)
  createdBy       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  recipients      EmailCampaignRecipient[]

  @@index([status])
  @@index([scheduledAt])
  @@index([templateId])
}

model EmailCampaignRecipient {
  id         String          @id @default(cuid())
  campaignId String
  campaign   EmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  email      String
  status     EmailSendStatus @default(PENDING)
  sentAt     DateTime?
  error      String?

  @@unique([campaignId, userId])
  @@index([campaignId, status])
}

model EmailSendLog {
  id                String        @id @default(cuid())
  type              EmailSendType @default(TRANSACTIONAL)
  campaignId        String?
  userId            String?
  email             String
  subject           String
  status            EmailSendStatus @default(SENT)
  provider          String?       // resend | smtp
  providerMessageId String?
  error             String?
  createdAt         DateTime      @default(now())

  @@index([type])
  @@index([campaignId])
  @@index([userId])
  @@index([email])
  @@index([createdAt])
}

model EmailUnsubscribe {
  id              String                    @id @default(cuid())
  userId          String?
  email           String
  category        EmailUnsubscribeCategory  @default(ALL)
  token           String                    @unique @default(cuid())
  unsubscribedAt  DateTime                  @default(now())

  @@unique([email, category])
  @@index([email])
  @@index([userId])
}

model WeeklyReportConfig {
  id              String   @id @default(cuid())
  enabled         Boolean  @default(false)
  customTitle     String?
  customHighlight String?
  ctaLabel        String?
  ctaUrl          String?
  footerPromo     String?
  sendDay         Int      @default(1) // 0=Sunday, 1=Monday ... 6=Saturday
  sendHour        Int      @default(9) // Hour in BRT (UTC-3)
  updatedAt       DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════
// RECEITA FEDERAL — Dados Abertos CNPJ (Empresas + CNAE)
// ═══════════════════════════════════════════════════════════════════

/// Tabela de referência CNAE — ~1.300 subclasses da classificação econômica.
model CnaeCode {
  code        String @id @db.VarChar(7)   // "7020400" (7 dígitos, sem pontuação)
  description String                      // "Atividades de consultoria em gestão empresarial"

  @@index([description])
}

/// Empresas da Receita Federal (dados abertos CNPJ).
/// Apenas matrizes ativas. Populada via script de importação.
model RfCompany {
  cnpj          String  @id @db.VarChar(14) // CNPJ completo (14 dígitos)
  razaoSocial   String                      // Razão social
  nomeFantasia  String?                     // Nome fantasia
  cnaePrincipal String  @db.VarChar(7)      // CNAE fiscal principal (7 dígitos)
  uf            String  @db.VarChar(2)      // UF (ex: "SP")
  municipio     String?                     // Nome do município
  cep           String? @db.VarChar(8)      // CEP (8 dígitos)
  bairro        String?                     // Bairro
  logradouro    String?                     // Tipo + Logradouro
  numero        String?                     // Número
  ddd           String? @db.VarChar(4)      // DDD telefone
  telefone      String?                     // Telefone
  email         String?                     // Email (correio eletrônico)
  porte         String?                     // "ME" (Micro), "EPP" (Pequeno Porte), "DEMAIS"
  capitalSocial Float?                      // Capital social (R$)
  dataAbertura  String?                     // Data início atividade (YYYYMMDD)

  @@index([cnaePrincipal])
  @@index([uf])
  @@index([uf, cnaePrincipal])
  @@index([cnaePrincipal, municipio, uf])
  @@index([municipio])
  @@index([municipio, uf, bairro])
  @@index([ddd, telefone])
  @@index([porte])
}

// ═══════════════════════════════════════════════════════════════════
// AUTO-PROSPECÇÃO — Módulo de prospecção automática de leads
// ═══════════════════════════════════════════════════════════════════

enum ProspectedLeadStatus {
  NEW        // Encontrado na busca RF
  ANALYZING  // IA processando
  SCORED     // Score calculado
  COLD       // Score < warmScoreMin — descartado
  WARM       // warmScoreMin ≤ score < hotScoreMin — nurturing
  HOT        // score ≥ hotScoreMin — ação imediata
  EMAILING   // Em sequência de email ativa
  CRM_SENT   // Enviado ao CRM
  ENGAGED    // Abriu ou clicou em email
  CONVERTED  // Virou cliente
  BOUNCED    // Email inválido / bounce
  OPTED_OUT  // Opt-out / unsubscribe
}

enum AutoProspTemplateType {
  HOT_COLD_INTRO       // D+0: Apresentação — leads quentes
  HOT_FOLLOW_NO_OPEN   // D+3: Follow-up se não abriu
  HOT_FOLLOW_OPENED    // D+3: Social proof se abriu mas não clicou
  HOT_LAST_ATTEMPT     // D+7: Última tentativa + oferta
  WARM_WEEK1_EDUCATION // S1: Conteúdo educativo — leads mornos
  WARM_WEEK2_VALUE     // S2: Email de valor / insight
  WARM_WEEK3_SOCIAL    // S3: Prova social / case
  WARM_WEEK4_OFFER     // S4: Oferta trial + CTA
  CUSTOM               // Template personalizado pelo usuário
}

enum AutoProspRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// Configuração principal do módulo de Auto-Prospecção (1 por workspace)
model AutoProspeccaoConfig {
  id                   String   @id @default(cuid())
  workspaceId          String   @unique

  isActive             Boolean  @default(false)

  // Agendamento
  scheduleDays         Json     @default("[1,2,3,4,5]")  // 1=Seg...7=Dom
  scheduleTimeStart    String   @default("08:00")
  scheduleTimeEnd      String   @default("20:00")
  searchIntervalHours  Int      @default(24)
  analyzeDelayMinutes  Int      @default(30)

  // Limites operacionais
  maxLeadsPerRun       Int      @default(50)
  maxEmailsPerDay      Int      @default(200)
  maxCrmPushPerDay     Int      @default(100)

  // Scoring
  hotScoreMin          Int      @default(70)
  warmScoreMin         Int      @default(40)

  // CRM
  crmAutoSend          Boolean  @default(false)
  crmProvider          String?  // "rdstation"|"hubspot"|"agendor"|"all"
  crmOwnerUserId       String?

  // Email
  emailAutoSend        Boolean  @default(true)
  emailStepIntervalHours Int    @default(48)
  defaultSequenceId    String?

  // Blacklist de CNPJs que nunca devem ser contatados
  blockedCnpjs         Json     @default("[]")

  // WhatsApp — Fase futura
  whatsappEnabled      Boolean  @default(false)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Perfis de busca pré-definidos usados pelo módulo de auto-prospecção.
/// isSystem=true = perfis do sistema criados pelo admin; null workspaceId = visível para todos.
model SearchProfile {
  id            String    @id @default(cuid())
  workspaceId   String?   // null → perfil do sistema (visível para todos)
  isSystem      Boolean   @default(false)
  isActive      Boolean   @default(true)
  name          String
  description   String?
  priority      Int       @default(0) // ordem de execução (menor = primeiro)

  // Filtros de busca
  cnae          String?   // CNAE único (ex: "7020400")
  cnaeList      Json?     // Lista de CNAEs ["7020400","7311400"]
  uf            Json?     // Lista de UFs ["SP","RJ","MG"]
  municipio     String?
  porte         Json?     // ["ME","EPP","DEMAIS"]
  hasEmail      Boolean?
  hasPhone      Boolean?
  minCapital    Float?
  openedAfter   String?   // Data mínima de abertura YYYYMMDD

  // Histórico de execução
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  totalFound    Int       @default(0)
  totalHot      Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  runs   AutoProspeccaoRun[]
  leads  ProspectedLead[]

  @@index([workspaceId, isActive])
  @@index([isSystem])
  @@index([nextRunAt])
}

/// Lead gerado automaticamente pelo módulo de auto-prospecção.
/// Deduplica por (workspaceId, cnpj).
model ProspectedLead {
  id                String               @id @default(cuid())
  workspaceId       String
  searchProfileId   String

  // Dados da empresa (espelho desnormalizado do RfCompany)
  cnpj              String               @db.VarChar(14)
  razaoSocial       String
  nomeFantasia      String?
  email             String?
  ddd               String?
  telefone          String?
  cnaePrincipal     String?
  uf                String?
  municipio         String?
  porte             String?

  // Score e análise IA
  score             Int?
  status            ProspectedLeadStatus @default(NEW)
  aiAnalysisSummary String?              @db.Text
  aiScoreFactors    Json?

  // CRM
  crmProvider       String?
  crmId             String?
  crmPushedAt       DateTime?

  // Email sequence
  emailSequenceId   String?

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  searchProfile SearchProfile  @relation(fields: [searchProfileId], references: [id], onDelete: Restrict)
  emailEvents   ProspectedLeadEmailEvent[]

  @@unique([workspaceId, cnpj])
  @@index([workspaceId, status])
  @@index([workspaceId, score(sort: Desc)])
  @@index([searchProfileId])
  @@index([createdAt(sort: Desc)])
}

/// Registro de cada step de email enviado para um ProspectedLead.
model ProspectedLeadEmailEvent {
  id         String    @id @default(cuid())
  leadId     String
  step       Int       // 1, 2, 3...
  subject    String
  templateId String?
  sentAt     DateTime?
  openedAt   DateTime?
  clickedAt  DateTime?
  bouncedAt  DateTime?

  lead ProspectedLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([leadId, step])
}

/// Pool de remetentes para auto-prospecção por workspace.
/// Permite múltiplos e-mails/domínios com balanceamento round-robin.
/// provider: "resend" | "smtp"
model AutoProspSenderPool {
  id                    String   @id @default(cuid())
  workspaceId           String
  label                 String   // Ex: "Domínio Principal", "Backup Gmail"
  provider              String   // "resend" | "smtp"
  fromEmail             String   // Ex: "Contato <contato@empresa.com>"
  isActive              Boolean  @default(true)
  dailyLimit            Int      @default(200) // limite de envios/dia por remetente
  sentToday             Int      @default(0)   // resetado pelo cron diário
  sentTodayResetAt      DateTime @default(now())
  lastUsedAt            DateTime?

  // Resend
  resendApiKeyEncrypted String?

  // SMTP
  smtpHost              String?
  smtpPort              Int?
  smtpUser              String?
  smtpPasswordEncrypted String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
}

/// Templates de email específicos do módulo de auto-prospecção.
/// isSystem=true = templates do sistema (somente leitura para usuários, podem clonar).
model AutoProspeccaoTemplate {
  id              String                @id @default(cuid())
  name            String
  type            AutoProspTemplateType
  subject         String
  preheader       String?
  bodyHtml        String                @db.Text
  bodyText        String?               @db.Text  // Versão plain text (fallback)
  variables       Json?                 // [{key,label}] variáveis disponíveis

  // Segmentação opcional (null = qualquer segmento)
  targetCnae      String?   // CNAE alvo (ex: "7020400")
  targetSegment   String?   // Segmento semântico ("consultorias","agencias","saas")

  isSystem        Boolean   @default(false)  // criado pelo admin da plataforma
  workspaceId     String?                    // null = sistema; workspace = personalizável

  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([type])
  @@index([isSystem])
  @@index([workspaceId])
}

/// Log de cada execução do módulo de auto-prospecção (manual ou cron).
model AutoProspeccaoRun {
  id              String             @id @default(cuid())
  workspaceId     String
  searchProfileId String?
  triggeredBy     String             // "cron"|"manual"|userId
  status          AutoProspRunStatus @default(RUNNING)

  // Métricas da execução
  leadsFound      Int @default(0)
  leadsAnalyzed   Int @default(0)
  leadsHot        Int @default(0)
  leadsWarm       Int @default(0)
  leadsCold       Int @default(0)
  leadsDedupSkip  Int @default(0)
  crmPushed       Int @default(0)
  emailsQueued    Int @default(0)

  errorLog        String?   @db.Text
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  searchProfile SearchProfile? @relation(fields: [searchProfileId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startedAt(sort: Desc)])
  @@index([status])
}
