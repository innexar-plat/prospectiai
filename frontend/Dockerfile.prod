# Production frontend + admin. Build from repo root: docker build -f frontend/Dockerfile.prod .

# Stage 1: install workspace dependencies once
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
COPY frontend/package.json frontend/package-lock.json* frontend/
COPY admin/package.json admin/package-lock.json* admin/
COPY backend/package.json backend/
COPY backend/prisma backend/prisma/
RUN npm install --legacy-peer-deps

# Stage 2: build main frontend
FROM node:20-alpine AS frontend-builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY --from=deps /app/frontend ./frontend
COPY --from=deps /app/admin ./admin
COPY --from=deps /app/backend ./backend
COPY frontend/ frontend/
# Vite embeds VITE_* at build time (use same values as .env / compose build.args)
ARG NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY
ARG VITE_MAINTENANCE_MODE
ARG VITE_API_URL
ARG VITE_SUPPORT_EMAIL
ARG VITE_SUPPORT_WHATSAPP
ARG VITE_VAPID_PUBLIC_KEY
ENV VITE_MERCADOPAGO_PUBLIC_KEY=$NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY
ENV VITE_MAINTENANCE_MODE=$VITE_MAINTENANCE_MODE
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL
ENV VITE_SUPPORT_WHATSAPP=$VITE_SUPPORT_WHATSAPP
ENV VITE_VAPID_PUBLIC_KEY=$VITE_VAPID_PUBLIC_KEY
RUN npm run build --workspace=frontend && node frontend/scripts/generate-seo-html.mjs

# Stage 3: build admin SPA (base /admin/)
FROM node:20-alpine AS admin-builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY --from=deps /app/frontend ./frontend
COPY --from=deps /app/admin ./admin
COPY --from=deps /app/backend ./backend
COPY admin/ admin/
RUN npm run build --workspace=admin

# Stage 4: nginx serves main SPA + admin at /admin/
FROM nginx:alpine AS runner
RUN rm /etc/nginx/conf.d/default.conf
COPY frontend/nginx.conf /etc/nginx/conf.d/app.conf
COPY frontend/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=frontend-builder /app/frontend/dist /usr/share/nginx/html
COPY --from=admin-builder /app/admin/dist /usr/share/nginx/html/admin
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
